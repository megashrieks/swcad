{
  "id": "phyllotaxis",
  "name": "Phyllotaxis",
  "version": "1.0.0",
  "category": "generative",
  "description": "The spiral a sunflower head packs its seeds into. Each new floret is turned by the golden angle from the last, which is the only rotation that never lines up into spokes.",
  "resizable": true,
  "defaultSize": { "w": 320, "h": 320 },
  "params": [
    { "name": "count", "type": "number", "label": "Florets", "default": 600, "min": 1, "step": 25 },
    { "name": "angle", "type": "number", "label": "Divergence", "default": 137.507, "step": 0.1 },
    { "name": "dotSize", "type": "number", "label": "Floret size", "default": 5, "min": 0.2, "step": 0.5 },
    { "name": "grow", "type": "number", "label": "Growth", "default": 0.65, "min": 0, "step": 0.05 },
    { "name": "padding", "type": "number", "label": "Padding", "default": 6, "min": 0, "step": 1 },
    { "name": "fill", "type": "color", "label": "Floret", "default": "var(--sw-ink)" },
    { "name": "coloring", "type": "enum", "label": "Colour", "default": "spiral", "options": ["spiral", "ring", "plain"] }
  ]
}
