{
  "id": "mondrian",
  "name": "Mondrian",
  "version": "1.0.0",
  "category": "generative",
  "description": "A rectangle split, and split again, until the pieces are small enough to stop. A few of them get colour and the rest stay white — the composition is entirely in where the cuts fall.",
  "resizable": true,
  "defaultSize": { "w": 360, "h": 360 },
  "params": [
    { "name": "seed", "type": "number", "label": "Seed", "default": 8, "step": 1 },
    { "name": "depth", "type": "number", "label": "Depth", "default": 5, "min": 0, "step": 1 },
    { "name": "minSize", "type": "number", "label": "Smallest piece", "default": 40, "min": 1, "step": 5 },
    { "name": "density", "type": "number", "label": "Colour density", "default": 0.32, "min": 0, "step": 0.05 },
    { "name": "bias", "type": "number", "label": "Cut spread", "default": 0.32, "min": 0, "step": 0.02 },
    { "name": "paper", "type": "color", "label": "Ground", "default": "var(--sw-paper)" },
    { "name": "stroke", "type": "color", "label": "Rule", "default": "var(--sw-ink)" },
    { "name": "strokeWidth", "type": "number", "label": "Rule width", "default": 5, "min": 0, "step": 1 },
    { "name": "colors", "type": "string", "label": "Palette", "default": "" }
  ]
}
