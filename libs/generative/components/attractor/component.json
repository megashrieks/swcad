{
  "id": "attractor",
  "name": "Strange attractor",
  "version": "1.0.0",
  "category": "generative",
  "description": "A point is fed through the same two equations over and over. It never repeats and never escapes, and the shape it wears into the frame is the attractor. Four numbers decide everything.",
  "resizable": true,
  "defaultSize": { "w": 360, "h": 360 },
  "params": [
    { "name": "variant", "type": "enum", "label": "Map", "default": "dejong", "options": ["dejong", "clifford", "svensson"] },
    { "name": "a", "type": "number", "label": "a", "default": -2, "step": 0.05 },
    { "name": "b", "type": "number", "label": "b", "default": -2.34, "step": 0.05 },
    { "name": "c", "type": "number", "label": "c", "default": -1.2, "step": 0.05 },
    { "name": "d", "type": "number", "label": "d", "default": 2, "step": 0.05 },
    { "name": "points", "type": "number", "label": "Points", "default": 20000, "min": 100, "step": 1000 },
    { "name": "padding", "type": "number", "label": "Padding", "default": 8, "min": 0, "step": 1 },
    { "name": "stroke", "type": "color", "label": "Ink", "default": "var(--sw-ink)" },
    { "name": "dotSize", "type": "number", "label": "Dot size", "default": 0.6, "min": 0.05, "step": 0.1 },
    { "name": "opacity", "type": "number", "label": "Opacity", "default": 0.35, "min": 0.02, "step": 0.05 }
  ]
}
