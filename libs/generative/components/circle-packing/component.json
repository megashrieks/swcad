{
  "id": "circle-packing",
  "name": "Circle packing",
  "version": "1.0.0",
  "category": "generative",
  "description": "Circles dropped one at a time, each grown until it touches something. The early ones get the room and the late ones fill the gaps, so the scale sorts itself out.",
  "resizable": true,
  "defaultSize": { "w": 360, "h": 360 },
  "params": [
    { "name": "seed", "type": "number", "label": "Seed", "default": 6, "step": 1 },
    { "name": "attempts", "type": "number", "label": "Attempts", "default": 900, "min": 1, "step": 100 },
    { "name": "minRadius", "type": "number", "label": "Smallest", "default": 3, "min": 0.2, "step": 0.5 },
    { "name": "maxRadius", "type": "number", "label": "Largest", "default": 52, "min": 0.5, "step": 2 },
    { "name": "gap", "type": "number", "label": "Gap", "default": 2, "min": 0, "step": 0.5 },
    { "name": "shape", "type": "enum", "label": "Bounds", "default": "rect", "options": ["rect", "circle"] },
    { "name": "fill", "type": "color", "label": "Fill", "default": "none" },
    { "name": "stroke", "type": "color", "label": "Outline", "default": "var(--sw-ink)" },
    { "name": "strokeWidth", "type": "number", "label": "Outline width", "default": 1.2, "min": 0, "step": 0.2 },
    { "name": "colorful", "type": "boolean", "label": "Colour by size", "default": false }
  ]
}
