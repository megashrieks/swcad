{
  "id": "maze",
  "name": "Maze",
  "version": "1.0.0",
  "category": "generative",
  "description": "A perfect maze carved from a seed. The walls are never stored, only the numbers that make them — and a connector dropped across it will find its way through.",
  "resizable": false,
  "defaultSize": { "w": 480, "h": 320 },
  "params": [
    { "name": "cols", "type": "number", "label": "Columns", "default": 12, "min": 1, "step": 1 },
    { "name": "rows", "type": "number", "label": "Rows", "default": 8, "min": 1, "step": 1 },
    { "name": "cell", "type": "number", "label": "Cell size", "default": 40, "min": 4, "step": 1 },
    { "name": "seed", "type": "number", "label": "Seed", "default": 1, "step": 1 },
    { "name": "stroke", "type": "color", "label": "Wall", "default": "var(--sw-ink)" },
    {
      "name": "strokeWidth",
      "type": "number",
      "label": "Wall width",
      "default": 3,
      "min": 0.5,
      "step": 0.5
    }
  ]
}
