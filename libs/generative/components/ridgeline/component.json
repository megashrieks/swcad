{
  "id": "ridgeline",
  "name": "Ridgeline",
  "version": "1.0.0",
  "category": "generative",
  "description": "Stacked ridges, each one hiding the part of the ridge behind it. The Joy Division plot: the same signal read many times, drawn front to back.",
  "resizable": true,
  "defaultSize": { "w": 360, "h": 380 },
  "params": [
    { "name": "seed", "type": "number", "label": "Seed", "default": 5, "step": 1 },
    { "name": "lines", "type": "number", "label": "Ridges", "default": 34, "min": 1, "step": 1 },
    { "name": "samples", "type": "number", "label": "Samples", "default": 160, "min": 2, "step": 10 },
    { "name": "amplitude", "type": "number", "label": "Amplitude", "default": 70, "min": 0, "step": 5 },
    { "name": "scale", "type": "number", "label": "Signal scale", "default": 4, "min": 0.1, "step": 0.25 },
    { "name": "spread", "type": "number", "label": "Peak spread", "default": 0.34, "min": 0.02, "step": 0.02 },
    { "name": "padding", "type": "number", "label": "Padding", "default": 12, "min": 0, "step": 2 },
    { "name": "stroke", "type": "color", "label": "Ridge", "default": "var(--sw-ink)" },
    { "name": "fill", "type": "color", "label": "Behind", "default": "var(--sw-paper)" },
    { "name": "strokeWidth", "type": "number", "label": "Ridge width", "default": 1.4, "min": 0.1, "step": 0.1 }
  ]
}
