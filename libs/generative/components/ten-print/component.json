{
  "id": "ten-print",
  "name": "10 PRINT",
  "version": "1.0.0",
  "category": "generative",
  "description": "10 PRINT CHR$(205.5+RND(1)); : GOTO 10 — the one-line Commodore 64 program. A coin flip per cell picks a slash or a backslash, and a maze that is not a maze falls out.",
  "resizable": true,
  "defaultSize": { "w": 400, "h": 280 },
  "params": [
    { "name": "seed", "type": "number", "label": "Seed", "default": 1, "step": 1 },
    { "name": "cols", "type": "number", "label": "Columns", "default": 24, "min": 1, "step": 1 },
    { "name": "rows", "type": "number", "label": "Rows", "default": 16, "min": 1, "step": 1 },
    { "name": "bias", "type": "number", "label": "Bias", "default": 0.5, "min": 0, "step": 0.05 },
    { "name": "stroke", "type": "color", "label": "Ink", "default": "var(--sw-ink)" },
    { "name": "strokeWidth", "type": "number", "label": "Line width", "default": 2.5, "min": 0.1, "step": 0.5 },
    { "name": "colorful", "type": "boolean", "label": "Colour the strokes", "default": false }
  ]
}
