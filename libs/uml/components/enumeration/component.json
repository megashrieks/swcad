{
  "id": "enumeration",
  "name": "Enumeration",
  "version": "1.0.0",
  "category": "structure",
  "description": "The «enumeration» keyword over a compartment of literals, one per line.",
  "defaultSize": {
    "w": 150,
    "h": 96
  },
  "params": [
    {
      "name": "name",
      "type": "string",
      "label": "Name",
      "default": "Status"
    },
    {
      "name": "literals",
      "type": "string",
      "label": "Literals",
      "default": "DRAFT\nOPEN\nCLOSED",
      "multiline": true
    },
    {
      "name": "fill",
      "type": "color",
      "label": "Fill",
      "default": "var(--sw-surface)"
    },
    {
      "name": "stroke",
      "type": "color",
      "label": "Stroke",
      "default": "var(--sw-ink)"
    },
    {
      "name": "ink",
      "type": "color",
      "label": "Text",
      "default": "var(--sw-ink)"
    },
    {
      "name": "fontSize",
      "type": "number",
      "label": "Font size",
      "default": 13,
      "min": 6
    },
    {
      "name": "lineWidth",
      "type": "number",
      "label": "Line width",
      "default": 1.2,
      "min": 0.2,
      "step": 0.1
    }
  ]
}
