{
  "id": "action",
  "name": "Action",
  "version": "1.0.0",
  "category": "behaviour",
  "description": "A rounded box: one step of an activity.",
  "defaultSize": {
    "w": 130,
    "h": 44
  },
  "params": [
    {
      "name": "name",
      "type": "string",
      "label": "Name",
      "default": "Validate order"
    },
    {
      "name": "fill",
      "type": "color",
      "label": "Fill",
      "default": "var(--sw-surface)"
    },
    {
      "name": "stroke",
      "type": "color",
      "label": "Stroke",
      "default": "var(--sw-ink)"
    },
    {
      "name": "ink",
      "type": "color",
      "label": "Text",
      "default": "var(--sw-ink)"
    },
    {
      "name": "fontSize",
      "type": "number",
      "label": "Font size",
      "default": 13,
      "min": 6
    },
    {
      "name": "lineWidth",
      "type": "number",
      "label": "Line width",
      "default": 1.2,
      "min": 0.2,
      "step": 0.1
    }
  ]
}
