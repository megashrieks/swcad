{
  "id": "use-case",
  "name": "Use case",
  "version": "1.0.0",
  "category": "behaviour",
  "description": "An ellipse holding the name of something the system does. The ellipse grows to fit the words.",
  "defaultSize": {
    "w": 130,
    "h": 60
  },
  "params": [
    {
      "name": "name",
      "type": "string",
      "label": "Name",
      "default": "Place order"
    },
    {
      "name": "fill",
      "type": "color",
      "label": "Fill",
      "default": "var(--sw-surface)"
    },
    {
      "name": "stroke",
      "type": "color",
      "label": "Stroke",
      "default": "var(--sw-ink)"
    },
    {
      "name": "ink",
      "type": "color",
      "label": "Text",
      "default": "var(--sw-ink)"
    },
    {
      "name": "fontSize",
      "type": "number",
      "label": "Font size",
      "default": 13,
      "min": 6
    },
    {
      "name": "lineWidth",
      "type": "number",
      "label": "Line width",
      "default": 1.2,
      "min": 0.2,
      "step": 0.1
    }
  ]
}
