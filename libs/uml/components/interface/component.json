{
  "id": "interface",
  "name": "Interface",
  "version": "1.0.0",
  "category": "structure",
  "description": "A class box with the «interface» keyword and a single operation compartment.",
  "defaultSize": {
    "w": 180,
    "h": 86
  },
  "params": [
    {
      "name": "name",
      "type": "string",
      "label": "Name",
      "default": "Interface"
    },
    {
      "name": "operations",
      "type": "string",
      "label": "Operations",
      "default": "+ run(): void",
      "multiline": true
    },
    {
      "name": "fill",
      "type": "color",
      "label": "Fill",
      "default": "var(--sw-surface)"
    },
    {
      "name": "stroke",
      "type": "color",
      "label": "Stroke",
      "default": "var(--sw-ink)"
    },
    {
      "name": "ink",
      "type": "color",
      "label": "Text",
      "default": "var(--sw-ink)"
    },
    {
      "name": "fontSize",
      "type": "number",
      "label": "Font size",
      "default": 13,
      "min": 6
    },
    {
      "name": "lineWidth",
      "type": "number",
      "label": "Line width",
      "default": 1.2,
      "min": 0.2,
      "step": 0.1
    }
  ]
}
