{
  "id": "package",
  "name": "Package",
  "version": "1.0.0",
  "category": "containers",
  "description": "A tabbed folder to group other elements. Open in the middle, so connectors inside it are not forced round the border.",
  "defaultSize": {
    "w": 260,
    "h": 170
  },
  "params": [
    {
      "name": "name",
      "type": "string",
      "label": "Name",
      "default": "domain"
    },
    {
      "name": "fill",
      "type": "color",
      "label": "Fill",
      "default": "none"
    },
    {
      "name": "stroke",
      "type": "color",
      "label": "Stroke",
      "default": "var(--sw-ink)"
    },
    {
      "name": "ink",
      "type": "color",
      "label": "Text",
      "default": "var(--sw-ink)"
    },
    {
      "name": "fontSize",
      "type": "number",
      "label": "Font size",
      "default": 13,
      "min": 6
    },
    {
      "name": "lineWidth",
      "type": "number",
      "label": "Line width",
      "default": 1.2,
      "min": 0.2,
      "step": 0.1
    }
  ]
}
