{
  "id": "fork",
  "name": "Fork / join",
  "version": "1.0.0",
  "category": "behaviour",
  "description": "The heavy bar that splits a flow into concurrent ones, or joins them back together.",
  "defaultSize": {
    "w": 110,
    "h": 6
  },
  "params": [
    {
      "name": "orientation",
      "type": "enum",
      "label": "Orientation",
      "default": "horizontal",
      "options": [
        "horizontal",
        "vertical"
      ]
    },
    {
      "name": "thickness",
      "type": "number",
      "label": "Thickness",
      "default": 5,
      "min": 2,
      "max": 20
    },
    {
      "name": "fill",
      "type": "color",
      "label": "Fill",
      "default": "var(--sw-surface)"
    },
    {
      "name": "stroke",
      "type": "color",
      "label": "Stroke",
      "default": "var(--sw-ink)"
    },
    {
      "name": "ink",
      "type": "color",
      "label": "Text",
      "default": "var(--sw-ink)"
    },
    {
      "name": "fontSize",
      "type": "number",
      "label": "Font size",
      "default": 13,
      "min": 6
    },
    {
      "name": "lineWidth",
      "type": "number",
      "label": "Line width",
      "default": 1.2,
      "min": 0.2,
      "step": 0.1
    }
  ]
}
