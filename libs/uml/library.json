    "components/deployment-node",
    "components/package",
    "components/frame",
    "components/note",
    "components/actor",
    "components/use-case",
    "components/boundary",
    "components/state",
    "components/action",
    "components/initial-node",
    "components/final-node",
    "components/flow-final",
    "components/decision",
    "components/fork",
    "components/object-node",
    "components/send-signal",
    "components/receive-signal",
    "components/history",
    "components/partition",
    "components/lifeline",
    "components/fragment",
    "components/association",
    "components/directed-association",
    "components/aggregation",
    "components/composition",
    "components/generalization",
    "components/realization",
    "components/dependency",
