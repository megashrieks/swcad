{
  "id": "cache",
  "name": "Cache",
  "version": "1.0.0",
  "category": "data",
  "description": "In-memory cache or key-value store.",
  "resizable": false,
  "defaultSize": {
    "w": 130,
    "h": 130
  },
  "params": [
    {
      "name": "title",
      "type": "string",
      "label": "Title",
      "default": "Cache"
    },
    {
      "name": "subtitle",
      "type": "string",
      "label": "Subtitle",
      "default": "Redis"
    },
    {
      "name": "accent",
      "type": "color",
      "label": "Icon",
      "default": "var(--sw-accent)"
    },
    {
      "name": "ink",
      "type": "color",
      "label": "Text",
      "default": "var(--sw-ink)"
    },
    {
      "name": "fontSize",
      "type": "number",
      "label": "Font size",
      "default": 13,
      "min": 6
    },
    {
      "name": "iconSize",
      "type": "number",
      "label": "Icon size",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "name": "iconStroke",
      "type": "number",
      "label": "Icon weight",
      "default": 1.8,
      "min": 0.2,
      "step": 0.1
    },
    {
      "name": "showIcon",
      "type": "boolean",
      "label": "Show icon",
      "default": true
    }
  ]
}
