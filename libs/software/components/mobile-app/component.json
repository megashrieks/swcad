{
  "id": "mobile-app",
  "name": "Mobile app",
  "version": "1.0.0",
  "category": "clients",
  "description": "Native or hybrid mobile client.",
  "resizable": false,
  "pivot": {
    "x": 0,
    "y": 0
  },
  "defaultSize": {
    "w": 130,
    "h": 130
  },
  "params": [
    {
      "name": "title",
      "type": "string",
      "label": "Title",
      "default": "Mobile app"
    },
    {
      "name": "subtitle",
      "type": "string",
      "label": "Subtitle",
      "default": ""
    },
    {
      "name": "accent",
      "type": "color",
      "label": "Icon",
      "default": "var(--sw-accent)"
    },
    {
      "name": "ink",
      "type": "color",
      "label": "Text",
      "default": "var(--sw-ink)"
    },
    {
      "name": "fontSize",
      "type": "number",
      "label": "Font size",
      "default": 13,
      "min": 6
    },
    {
      "name": "iconSize",
      "type": "number",
      "label": "Icon size",
      "default": 40,
      "min": 8,
      "step": 1
    },
    {
      "name": "iconStroke",
      "type": "number",
      "label": "Icon weight",
      "default": 1.8,
      "min": 0.2,
      "step": 0.1
    },
    {
      "name": "showIcon",
      "type": "boolean",
      "label": "Show icon",
      "default": true
    }
  ]
}
