{
  "body": {
    "kind": "hit_area"
  },
  "title": {
    "kind": "label",
    "bind": "params.title",
    "align": "center",
    "editable": true
  },
  "subtitle": {
    "kind": "label",
    "bind": "params.subtitle",
    "align": "center",
    "editable": true
  },
  "edge": {
    "kind": "port",
    "name": "edge",
    "direction": "inout",
    "surface": "outline"
  },
  "grip": {
    "kind": "handle",
    "name": "resize",
    "drives": [
      "size.w",
      "size.h"
    ],
    "axis": "both",
    "min": 40
  }
}
